# Environnement de validation : Node + Chromium (paquets Debian), aucune dépendance npm.
FROM node:22-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends chromium fonts-liberation fonts-noto-color-emoji git \
 && rm -rf /var/lib/apt/lists/* \
 && git config --system safe.directory '*'
ENV CHROME=/usr/bin/chromium
WORKDIR /app
